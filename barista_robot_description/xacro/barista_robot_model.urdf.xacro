<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="barista_bot">

  <xacro:include filename="$(find barista_robot_description)/xacro/inertia_calculations.xacro"/>
  <xacro:include filename="$(find barista_robot_description)/xacro/drive_wheel.xacro" />
  <xacro:include filename="$(find barista_robot_description)/xacro/caster_wheel.xacro" />

  <xacro:property name="body_radius" value="0.178"/>
  <xacro:property name="body_height" value="0.155"/>
  <xacro:property name="body_mass" value="0.5"/>
  <xacro:property name="wheel_width" value="0.0206"/>
  <xacro:property name="wheel_radius" value="0.0352"/>
  <xacro:property name="wheel_mass" value="0.05"/>
  <xacro:property name="wheel_rpy" value="1.5707 1.5707 0"/>

  <material name="blue">
      <color rgba="0.0 0.0 1.0 1"/>
  </material>

  <material name="yellow">
      <color rgba="1.0 1.0 0.0 1"/>
  </material>

  <material name="red">
      <color rgba="1.0 0.0 0.0 1"/>
  </material>

  <material name="green_dark">
    <color rgba="0.0 0.5 0.0 1"/>
  </material>

  <material name="black">
      <color rgba="0.0 0.0 0.0 1"/>
  </material>

  <link name="base_link">
  </link>

  <!-- Body -->
  <link name="main_body">
    <visual>
      <geometry>
        <cylinder length="${body_height}" radius="${body_radius}"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="${body_height}" radius="${body_radius}"/>
      </geometry>
    </collision>

  <xacro:cylinder_inertia
      mass="${body_mass}"
      radius="${body_radius}"
      length="${body_height}"/>

  </link>

  <joint name="base_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="base_link" />
    <child link="main_body" />
  </joint>

  <!-- Left Wheel -->
  <xacro:wheel_macro
      wheel_name="left_wheel"
      radius="${wheel_radius}"
      length="${wheel_width}"
      mass="${wheel_mass}"
      rpy="${wheel_rpy}"
      parent_link="main_body"
      joint_xyz="0 0.158 -0.0775"/>
  <!-- <joint name="joint_left_wheel" type="continuous">
    <origin rpy="0 0 0" xyz="0 0.158 -0.0775"/>
    <child link="left_wheel"/>
    <parent link="main_body"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
  </joint> -->

  <!-- Right Wheel -->
  <xacro:wheel_macro
      wheel_name="right_wheel"
      radius="${wheel_radius}"
      length="${wheel_width}"
      mass="${wheel_mass}"
      rpy="${wheel_rpy}"
      parent_link="main_body"
      joint_xyz="0 -0.158 -0.0775"/>

  <!-- <joint name="joint_right_wheel" type="continuous">
    <origin rpy="0 0 0" xyz="0 -0.158 -0.0775"/>
    <child link="right_wheel"/>
    <parent link="main_body"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
  </joint> -->

  <!-- Front Caster Wheel -->
  <xacro:caster_wheel_macro
      caster_wheel_name="front"
      radius="${wheel_radius}"
      caster_color="red"
      parent_link="main_body"
      joint_xyz="0.138 0 -0.0775"/>

    <!-- <joint name="front_yaw_joint" type="continuous">
        <origin rpy="0 0 0" xyz="0.138 0 -0.0775" />
        <parent link="main_body" />
        <child link="front_yaw_link" />
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="100.0" />
        <dynamics damping="0.0" friction="0.1"/>
    </joint> -->

  <!-- Rear Caster Wheel -->
  <xacro:caster_wheel_macro
      caster_wheel_name="rear"
      radius="${wheel_radius}"
      caster_color="green_dark"
      parent_link="main_body"
      joint_xyz="-0.138 0 -0.0775"/>

  <!-- <joint name="rear_yaw_joint" type="continuous">
    <origin rpy="0 0 0" xyz="-0.138 0 -0.0775" />
    <parent link="main_body" />
    <child link="rear_yaw_link" />
    <axis xyz="0 0 1" />
    <limit effort="1000.0" velocity="100.0" />
    <dynamics damping="0.0" friction="0.1"/>
  </joint> -->

  <!-- Differential Drive Plugin -->
  <gazebo>
    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>joint_left_wheel</left_joint>
        <right_joint>joint_right_wheel</right_joint>
        <wheel_separation>0.316</wheel_separation>
        <wheel_radius>0.0352</wheel_radius>
        <topic>cmd_vel</topic>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Joint state publisher plugin -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
          name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

</robot>
