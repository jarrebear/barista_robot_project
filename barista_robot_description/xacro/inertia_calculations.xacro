<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="cylinder_inertia"
             params="mass radius length xyz:='0 0 0' rpy:='0 0 0'">
  <inertial>
    <origin xyz="${xyz}" rpy="${rpy}"/>
    <mass value="${mass}"/>
    <inertia
      ixx="${mass * (3*radius*radius + length*length) / 12.0}"
      ixy="0.0"
      ixz="0.0"
      iyy="${mass * (3*radius*radius + length*length) / 12.0}"
      iyz="0.0"
      izz="${0.5 * mass * radius * radius}"/>
  </inertial>
</xacro:macro>

<xacro:macro name="sphere_inertia"
             params="mass radius xyz:='0 0 0' rpy:='0 0 0'">
  <inertial>
    <origin xyz="${xyz}" rpy="${rpy}"/>
    <mass value="${mass}"/>
    <inertia
      ixx="${mass * (2*radius*radius ) / 5.0}"
      ixy="0.0"
      ixz="0.0"
      iyy="${mass * (2*radius*radius ) / 5.0}"
      iyz="0.0"
      izz="${mass * (2*radius*radius ) / 5.0}"/>
  </inertial>
</xacro:macro>

</robot>
