<?xml version="1.0"?>
<robot name="barista_bot">

  <material name="black">
      <color rgba="0.0 0.0 0.0 1"/>
  </material>

  <material name="blue">
      <color rgba="0.0 0.0 1.0 1"/>
  </material>

  <material name="red">
      <color rgba="1.0 0.0 0.0 1"/>
  </material>

  <material name="green_dark">
    <color rgba="0.0 0.5 0.0 1"/>
  </material>

  <material name="yellow">
      <color rgba="1.0 1.0 0.0 1"/>
  </material>

  <material name="grey">
      <color rgba="0.5 0.5 0.5 1"/>
  </material>


  <link name="base_link">
  </link>

  <!-- Body -->
  <link name="main_body">
    <visual>
      <geometry>
        <cylinder length="0.155" radius="0.178"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.155" radius="0.178"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0049615417" ixy="0" ixz="0" iyy="0.0049615417" iyz="0" izz="0.007921"/>
    </inertial>

  </link>

  <joint name="base_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="base_link" />
    <child link="main_body" />
  </joint>

  <!-- Wheel Left -->
  <link name="left_wheel">      
      <visual>
        <origin rpy="1.5707 1.5707 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.0206" radius="0.0352"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin rpy="1.5707 1.5707 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.0206" radius="0.0352"/>
        </geometry>
      </collision>

      <inertial>
        <origin rpy="1.5707 1.5707 0" xyz="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.00001725617" ixy="0" ixz="0" iyy="0.00001725617" iyz="0" izz="0.000030976"/>
      </inertial>

  </link>

  <gazebo reference="left_wheel">
    <collision>
        <surface>
        <friction>
            <ode>
            <mu>10.0</mu>
            <mu2>10.0</mu2>
            </ode>
        </friction>
        <contact>
            <ode>
            <kp>10000000.0</kp>
            <kd>10000000.0</kd>
            </ode>
        </contact>
        </surface>
    </collision>
  </gazebo>

  <joint name="joint_left_wheel" type="continuous">
    <origin rpy="0 0 0" xyz="0 0.158 -0.0775"/>
    <child link="left_wheel"/>
    <parent link="main_body"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
  </joint>

  <!-- Wheel Right -->
  <link name="right_wheel">      
      <visual>
        <origin rpy="1.5707 1.5707 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.0206" radius="0.0352"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin rpy="1.5707 1.5707 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.0206" radius="0.0352"/>
        </geometry>
      </collision>

      <inertial>
        <origin rpy="1.5707 1.5707 0" xyz="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.00001725617" ixy="0" ixz="0" iyy="0.00001725617" iyz="0" izz="0.000030976"/>
      </inertial>

  </link>

  <gazebo reference="right_wheel">
    <collision>
        <surface>
        <friction>
            <ode>
            <mu>10.0</mu>
            <mu2>10.0</mu2>
            </ode>
        </friction>
        <contact>
            <ode>
            <kp>10000000.0</kp>
            <kd>10000000.0</kd>
            </ode>
        </contact>
        </surface>
    </collision>
  </gazebo>

  <joint name="joint_right_wheel" type="continuous">
    <origin rpy="0 0 0" xyz="0 -0.158 -0.0775"/>
    <child link="right_wheel"/>
    <parent link="main_body"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <limit effort="10000" velocity="1000"/>
    <joint_properties damping="1.0" friction="1.0"/>
  </joint>

  <!-- Caster Wheel Front -->
  <link name="front_yaw_link">
      <visual>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry>          
          <cylinder length="0.001" radius="0.0045000000000000005"/>
        </geometry>
        <material name="blue"/>
      </visual>

      <collision>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.001" radius="0.0045000000000000005"/>
        </geometry>
      </collision>

      <inertial>
          <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
          <mass value="0.001"/>
          <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
      </inertial>

  </link>

  <joint name="front_yaw_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.138 0 -0.0775" />
    <parent link="main_body" />
    <child link="front_yaw_link" />
    <axis xyz="0 0 1" />
    <limit effort="1000.0" velocity="100.0" />
    <dynamics damping="0.0" friction="0.1"/>
  </joint>

  <link name="front_roll_link">
      <visual>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.001" radius="0.0045000000000000005"/>
        </geometry>
        <material name="red"/>
      </visual>

      <collision>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.001" radius="0.0045000000000000005"/>
        </geometry>
      </collision>

      <inertial>
          <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
          <mass value="0.001"/>
          <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
      </inertial>
  </link>

  <joint name="front_roll_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="front_yaw_link" />
    <child link="front_roll_link" />
    <axis xyz="1 0 0" />
    <limit effort="1000.0" velocity="100.0" />
    <dynamics damping="0.0" friction="0.1"/>
  </joint>

  <link name="front_pitch_link">
    <visual>
      <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.0352"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.0352"/>
      </geometry>
    </collision>

    <inertial>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <mass value="0.010"/>
        <inertia ixx="4.95616e-06" ixy="0" ixz="0" iyy="4.95616e-06" iyz="0" izz="4.95616e-06"/>
    </inertial>
  </link>

  <gazebo reference="front_pitch_link">
    <collision>
        <surface>
        <friction>
            <ode>
            <mu>0.5</mu>
            <mu2>0.5</mu2>
            </ode>
        </friction>
        <contact>
            <ode>
            <kp>10000000.0</kp>
            <kd>10000000.0</kd>
            </ode>
        </contact>
        </surface>
    </collision>
  </gazebo>

  <joint name="front_pitch_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="front_roll_link" />
    <child link="front_pitch_link" />
    <axis xyz="0 1 0" />
    <limit effort="1000.0" velocity="100.0" />
    <dynamics damping="0.0" friction="0.1"/>
  </joint>

  <!-- Caster Wheel Rear -->
  <link name="rear_yaw_link">
      <visual>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry>          
          <cylinder length="0.001" radius="0.0045000000000000005"/>
        </geometry>
        <material name="blue"/>
      </visual>

      <collision>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.001" radius="0.0045000000000000005"/>
        </geometry>
      </collision>

      <inertial>
          <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
          <mass value="0.001"/>
          <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
      </inertial>

  </link>

  <joint name="rear_yaw_joint" type="continuous">
    <origin rpy="0 0 0" xyz="-0.138 0 -0.0775" />
    <parent link="main_body" />
    <child link="rear_yaw_link" />
    <axis xyz="0 0 1" />
    <limit effort="1000.0" velocity="100.0" />
    <dynamics damping="0.0" friction="0.1"/>
  </joint>

  <link name="rear_roll_link">
      <visual>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.001" radius="0.0045000000000000005"/>
        </geometry>
        <material name="red"/>
      </visual>

      <collision>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.001" radius="0.0045000000000000005"/>
        </geometry>
      </collision>

      <inertial>
          <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
          <mass value="0.001"/>
          <inertia ixx="5.145833333333334e-09" ixy="0" ixz="0" iyy="5.145833333333334e-09" iyz="0" izz="1.0125000000000003e-08"/>
      </inertial>
  </link>

  <joint name="rear_roll_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="rear_yaw_link" />
    <child link="rear_roll_link" />
    <axis xyz="1 0 0" />
    <limit effort="1000.0" velocity="100.0" />
    <dynamics damping="0.0" friction="0.1"/>
  </joint>

  <link name="rear_pitch_link">
    <visual>
      <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.0352"/>
      </geometry>
      <material name="green_dark"/>
    </visual>

    <collision>
      <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.0352"/>
      </geometry>
    </collision>

    <inertial>
        <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
        <mass value="0.010"/>
        <inertia ixx="4.95616e-06" ixy="0" ixz="0" iyy="4.95616e-06" iyz="0" izz="4.95616e-06"/>
    </inertial>
  </link>

  <gazebo reference="rear_pitch_link">
    <collision>
        <surface>
        <friction>
            <ode>
            <mu>0.5</mu>
            <mu2>0.5</mu2>
            </ode>
        </friction>
        <contact>
            <ode>
            <kp>10000000.0</kp>
            <kd>10000000.0</kd>
            </ode>
        </contact>
        </surface>
    </collision>
  </gazebo>

  <joint name="rear_pitch_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="rear_roll_link" />
    <child link="rear_pitch_link" />
    <axis xyz="0 1 0" />
    <limit effort="1000.0" velocity="100.0" />
    <dynamics damping="0.0" friction="0.1"/>
  </joint>


  <!-- Differential Drive Plugin -->
  <gazebo>
    <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>joint_left_wheel</left_joint>
        <right_joint>joint_right_wheel</right_joint>
        <wheel_separation>0.316</wheel_separation>
        <wheel_radius>0.0352</wheel_radius>
        <topic>cmd_vel</topic>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

  <!-- Standoff Rod 1 -->
  <link name="standoff_rod_1_link">
    <visual>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000202917" ixy="0" ixz="0" iyy="0.000202917" iyz="0" izz="0.0000025"/>
    </inertial>

  </link>

  <joint name="standoff_rod_1_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.06 0.128 0.1875" />
    <parent link="main_body" />
    <child link="standoff_rod_1_link" />
  </joint>

  <!-- Standoff Rod 2 -->
  <link name="standoff_rod_2_link">
    <visual>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000202917" ixy="0" ixz="0" iyy="0.000202917" iyz="0" izz="0.0000025"/>
    </inertial>

  </link>

  <joint name="standoff_rod_2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.06 0.128 0.1875" />
    <parent link="main_body" />
    <child link="standoff_rod_2_link" />
  </joint>

  <!-- Standoff Rod 3 -->
  <link name="standoff_rod_3_link">
    <visual>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000202917" ixy="0" ixz="0" iyy="0.000202917" iyz="0" izz="0.0000025"/>
    </inertial>

  </link>

  <joint name="standoff_rod_3_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.06 -0.128 0.1875" />
    <parent link="main_body" />
    <child link="standoff_rod_3_link" />
  </joint>

  <!-- Standoff Rod 4 -->
  <link name="standoff_rod_4_link">
    <visual>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.220" radius="0.01"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000202917" ixy="0" ixz="0" iyy="0.000202917" iyz="0" izz="0.0000025"/>
    </inertial>

  </link>

  <joint name="standoff_rod_4_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.06 -0.128 0.1875" />
    <parent link="main_body" />
    <child link="standoff_rod_4_link" />
  </joint>


  <!-- Cupholder Tray -->
  <link name="cupholder_tray_link">
    <visual>
      <geometry>
        <cylinder length="0.090" radius="0.160"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.090" radius="0.160"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.001415" ixy="0" ixz="0" iyy="0.001415" iyz="0" izz="0.00002"/>
    </inertial>

  </link>

  <joint name="cupholder_tray_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.3425" />
    <parent link="main_body" />
    <child link="cupholder_tray_link" />
  </joint>

 <!-- Lidar -->
  <link name="laser_scan_link">
    <visual>
      <geometry>
        <mesh filename="package://barista_robot_description/meshes/velodyne_puck.dae" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="1.67e-06" ixy="0" ixz="0" iyy="1.67e-06" iyz="0" izz="1.67e-06"/>
    </inertial>

  </link>

  <joint name="laser_scan_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.118 0 0.0775"  />
    <parent link="main_body" />
    <child link="laser_scan_link" />
  </joint>

  <link name="laser_scan_frame">
  </link>

  <joint name="laser_scan_frame_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.04"/>
    <parent link="laser_scan_link"/>
    <child link="laser_scan_frame"/>
    <axis xyz="0 0 0"/>
  </joint>

<!-- Enable Sensors in Gazebo Sim -->
<gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <!-- use ogre2 if ogre v2.x is installed, otherwise use ogre -->
        <render_engine>ogre2</render_engine>
    </plugin>
</gazebo>

<!-- Laser Scanner Plugin -->
<gazebo reference="laser_scan_frame">
    <sensor type="gpu_lidar" name="gpu_lidar">
        <pose relative_to='laser_scan_frame'>0 0 0 0 0 0</pose>
        <gz_frame_id>laser_scan_frame</gz_frame_id>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <update_rate>100</update_rate>
        <topic>laser_scan</topic>
        <ray>
            <scan>
                <horizontal>
                    <samples>200</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.1</min>
                <max>5.0</max>
                <resolution>0.01</resolution>
            </range>
        </ray>
    </sensor>
</gazebo>

</robot>