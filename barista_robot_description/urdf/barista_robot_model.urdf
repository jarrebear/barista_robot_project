<?xml version="1.0"?>
<robot name="barista_bot">


  <link name="base_link">
  </link>

  <!-- Body -->
  <link name="main_body">
    <visual>
      <geometry>
        <cylinder length="0.155" radius="0.178"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.155" radius="0.178"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0049615417" ixy="0" ixz="0" iyy="0.0049615417" iyz="0" izz="0.007921"/>
    </inertial>

  </link>

  <joint name="base_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="base_link" />
    <child link="main_body" />
  </joint>


</robot>